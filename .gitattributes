# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts and Docker/Makefiles MUST keep LF for Linux/Docker compatibility
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webm binary
*.mp4 binary
*.npy binary
*.npz binary
*.parquet binary
*.tif binary
*.tiff binary
